{
  "openapi": "3.0.3",
  "info": {
    "title": "pudans Public API",
    "version": "1.0.0",
    "description": "pudans enterprise identity and permission management API."
  },
  "servers": [
    {
      "url": "http://localhost:8090"
    }
  ],
  "security": [
    {
      "basicAuth": [],
      "bearerAuth": []
    }
  ],
  "paths": {
    "/apis/public.api.pudans.tolim.cn/v1alpha1/system/setup": {
      "get": {
        "description": "Jump to setup page",
        "operationId": "JumpToSetupPage",
        "responses": {
          "default": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "default response"
          }
        },
        "tags": [
          "SystemV1alpha1Public"
        ]
      },
      "post": {
        "description": "Setup system",
        "operationId": "SetupSystem",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "content": {},
            "description": "No Content"
          }
        },
        "tags": [
          "SystemV1alpha1Public"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AddOperation": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add"
            ]
          },
          "path": {
            "type": "string",
            "description": "A JSON Pointer path pointing to the location to move/copy from.",
            "example": "/a/b/c",
            "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
          },
          "value": {
            "description": "Value can be any JSON value"
          }
        },
        "required": [
          "op",
          "path",
          "value"
        ]
      },
      "CopyOperation": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "A JSON Pointer path pointing to the location to move/copy from.",
            "example": "/a/b/c",
            "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
          },
          "op": {
            "type": "string",
            "enum": [
              "copy"
            ]
          },
          "path": {
            "type": "string",
            "description": "A JSON Pointer path pointing to the location to move/copy from.",
            "example": "/a/b/c",
            "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
          }
        },
        "required": [
          "from",
          "op",
          "path"
        ]
      },
      "JsonPatch": {
        "type": "array",
        "description": "JSON schema for JSONPatch operations",
        "items": {
          "oneOf": [
            {
              "$ref": "#/components/schemas/AddOperation"
            },
            {
              "$ref": "#/components/schemas/ReplaceOperation"
            },
            {
              "$ref": "#/components/schemas/TestOperation"
            },
            {
              "$ref": "#/components/schemas/RemoveOperation"
            },
            {
              "$ref": "#/components/schemas/MoveOperation"
            },
            {
              "$ref": "#/components/schemas/CopyOperation"
            }
          ]
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "MoveOperation": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "A JSON Pointer path pointing to the location to move/copy from.",
            "example": "/a/b/c",
            "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
          },
          "op": {
            "type": "string",
            "enum": [
              "move"
            ]
          },
          "path": {
            "type": "string",
            "description": "A JSON Pointer path pointing to the location to move/copy from.",
            "example": "/a/b/c",
            "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
          }
        },
        "required": [
          "from",
          "op",
          "path"
        ]
      },
      "RemoveOperation": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "remove"
            ]
          },
          "path": {
            "type": "string",
            "description": "A JSON Pointer path pointing to the location to move/copy from.",
            "example": "/a/b/c",
            "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
          }
        },
        "required": [
          "op",
          "path"
        ]
      },
      "ReplaceOperation": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "replace"
            ]
          },
          "path": {
            "type": "string",
            "description": "A JSON Pointer path pointing to the location to move/copy from.",
            "example": "/a/b/c",
            "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
          },
          "value": {
            "description": "Value can be any JSON value"
          }
        },
        "required": [
          "op",
          "path",
          "value"
        ]
      },
      "SetupRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "externalUrl": {
            "type": "string",
            "pattern": "^(http|https).*"
          },
          "language": {
            "type": "string",
            "pattern": "^(zh-CN|zh-TW|en|es)$"
          },
          "password": {
            "type": "string",
            "maxLength": 257,
            "minLength": 5,
            "pattern": "^[A-Za-z0-9!@#$%^&*.?]+$"
          },
          "siteTitle": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "username": {
            "type": "string",
            "maxLength": 63,
            "minLength": 4,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
          }
        },
        "required": [
          "externalUrl",
          "password",
          "siteTitle",
          "username"
        ]
      },
      "TestOperation": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "test"
            ]
          },
          "path": {
            "type": "string",
            "description": "A JSON Pointer path pointing to the location to move/copy from.",
            "example": "/a/b/c",
            "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
          },
          "value": {
            "description": "Value can be any JSON value"
          }
        },
        "required": [
          "op",
          "path",
          "value"
        ]
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      },
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  }
}
