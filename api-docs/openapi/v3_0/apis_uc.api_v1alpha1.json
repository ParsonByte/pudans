  "components": {
    "schemas": {
      "AddOperation": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add"
            ]
          },
          "path": {
            "type": "string",
            "description": "A JSON Pointer path pointing to the location to move/copy from.",
            "example": "/a/b/c",
            "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
          },
          "value": {
            "description": "Value can be any JSON value"
          }
        },
        "required": [
          "op",
          "path",
          "value"
        ]
      },
