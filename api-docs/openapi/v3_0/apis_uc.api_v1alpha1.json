            "type": "integer",
            "format": "int32",
            "description": "Size of each page. If not set or equal to 0, it means no pagination."
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Total elements."
          },
          "totalPages": {
            "type": "integer",
            "format": "int64",
            "description": "Indicates total pages."
          }
        },
        "required": [
          "first",
          "hasNext",
          "hasPrevious",
          "items",
          "last",
          "page",
          "size",
          "total",
          "totalPages"
        ]
      },
