PUDANS_REGISTRY=pudans
PUDANS_TAG=local
PUDANS_DOCKER_NETWORK=1panel-network

PUDANS_NACOS_ADDR=nacos:8848
PUDANS_DB_HOST=postgresql
PUDANS_DB_PORT=5432
PUDANS_DB_USER=pudans
PUDANS_DB_PASSWORD=
PUDANS_REDIS_HOST=redis
PUDANS_REDIS_PORT=6379

PUDANS_INTERNAL_TOKEN=
PUDANS_JWT_SECRET=

PUDANS_ENVIRONMENT=production
PUDANS_TRACING_SAMPLING=0.1
PUDANS_TRACING_EXPORT_ENABLED=true
PUDANS_OTLP_TRACING_ENDPOINT=http://jaeger:4318/v1/traces

PUDANS_MANAGEMENT_BIND=127.0.0.1

PUDANS_GATEWAY_BIND=0.0.0.0
PUDANS_GATEWAY_PORT=8080
PUDANS_TRUSTED_PROXIES=.*
PUDANS_CORS_ALLOWED_ORIGINS=https://pudans.example.com
PUDANS_HOME_URI=https://pudans.example.com
PUDANS_LOGIN_URI=https://pudans.example.com
PUDANS_LOGIN_PAGE_URL=/login
PUDANS_HOME_ORIGIN=https://pudans.example.com
PUDANS_COOKIE_SECURE=true
PUDANS_COOKIE_DOMAIN=.example.com
PUDANS_SESSION_COOKIE_NAME=PUDANS_SID
PUDANS_GATEWAY_SESSION_ENABLED=true

PUDANS_SENTINEL_DASHBOARD=sentinel:8858

PUDANS_MESSAGING_BROKER=in-memory
PUDANS_ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876
PUDANS_ROCKETMQ_ACCESS_KEY=
PUDANS_ROCKETMQ_SECRET_KEY=

PUDANS_REPOSITORY_DEFAULT_PROVIDER=local
PUDANS_REPOSITORY_LOCAL_DIR=/var/lib/pudans/repository

PUDANS_MAIL_HOST=
PUDANS_MAIL_PORT=25
PUDANS_MAIL_USERNAME=
PUDANS_MAIL_PASSWORD=
PUDANS_MAIL_FROM=no-reply@pudans.local
PUDANS_MAIL_SMTP_AUTH=false
PUDANS_MAIL_STARTTLS_ENABLED=false
PUDANS_MAIL_SSL_ENABLED=false
PUDANS_NOTIFICATION_MAIL_ENABLED=false
PUDANS_NOTIFICATION_SMS_ENABLED=false
PUDANS_NOTIFICATION_SMS_PROVIDER=

SPISSATUS_KEY_PROVIDER=memory
SPISSATUS_KEY_FILE_DIRECTORY=/var/lib/pudans/keys
SPISSATUS_KEY_MASTER_PASSWORD=
SPISSATUS_KEYSTORE_PATH=
SPISSATUS_KEYSTORE_PASSWORD=

PUDANS_LOG_STRUCTURED=true
PUDANS_JAVA_OPTS=