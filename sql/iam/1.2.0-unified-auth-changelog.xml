                <constraints nullable="true"/>
            </column>
        </createTable>

        <createTable remarks="应用服务动作表" tableName="${pudans_table_prefix}service_action">
            <column name="id_" remarks="主键ID" type="VARCHAR(64)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="app_id" remarks="应用ID" type="VARCHAR(64)">
