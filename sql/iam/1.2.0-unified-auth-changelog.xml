            <column name="code_" remarks="资源类型编码（{appCode}:{resourceType}）" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="name_" remarks="资源类型名称" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="pattern_" remarks="资源模式（org/{orgId}/{appCode}/{resourceType}/{resourceId}）" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status_" remarks="状态（ENABLED、DISABLED）" type="VARCHAR(32)" defaultValue="ENABLED">
                <constraints nullable="false"/>
            </column>
            <column name="create_by" remarks="创建者" type="VARCHAR(64)">
