                <constraints nullable="false"/>
            </column>
            <column name="principal_id" remarks="主体ID" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="scope_" remarks="生效范围（应用编码或资源前缀，* 表示全部）" type="VARCHAR(255)"/>
            <column name="create_by" remarks="创建者" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column defaultValueComputed="CURRENT_TIMESTAMP" name="create_time" remarks="创建时间" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="update_by" remarks="修改者" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column defaultValueComputed="CURRENT_TIMESTAMP" name="update_time" remarks="修改时间" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="remark_" remarks="备注" type="TEXT"/>
            <column name="is_deleted" remarks="删除标记" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <createTable remarks="授权角色表" tableName="${pudans_table_prefix}authz_role">
            <column name="id_" remarks="主键ID" type="VARCHAR(64)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="code_" remarks="角色编码" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="name_" remarks="角色名称" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="trust_policy" remarks="角色信任策略" type="JSONB"/>
            <column name="status_" remarks="状态（ENABLED、DISABLED）" type="VARCHAR(32)" defaultValue="ENABLED">
                <constraints nullable="false"/>
            </column>
            <column name="desc_" remarks="描述" type="VARCHAR(500)"/>
            <column name="create_by" remarks="创建者" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column defaultValueComputed="CURRENT_TIMESTAMP" name="create_time" remarks="创建时间" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="update_by" remarks="修改者" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column defaultValueComputed="CURRENT_TIMESTAMP" name="update_time" remarks="修改时间" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="remark_" remarks="备注" type="TEXT"/>
            <column name="is_deleted" remarks="删除标记" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="true"/>
            </column>
        </createTable>

