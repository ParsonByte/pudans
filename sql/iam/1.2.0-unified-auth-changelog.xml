        <createTable remarks="鉴权决策日志表" tableName="${pudans_table_prefix}authz_log">
            <column name="id_" remarks="主键ID" type="VARCHAR(64)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="principal_type" remarks="主体类型（USER、USER_GROUP、ROLE、ORGANIZATION、CLIENT）"
                    type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="principal_id" remarks="主体ID" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="app_code" remarks="应用编码" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="action_" remarks="动作（{appCode}:{action}）" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="resource_" remarks="资源（{appCode}:{resourceType}/{resourceId}）" type="VARCHAR(500)"/>
            <column name="decision" remarks="决策结果（ALLOW、DENY）" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" remarks="决策原因" type="VARCHAR(500)"/>
            <column name="context" remarks="决策上下文" type="JSONB"/>
            <column defaultValueComputed="CURRENT_TIMESTAMP" name="created_at" remarks="创建时间" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>

