{
  "name": "@pudans/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build:api-client": "npm run build --workspace @pudans-dev/api-client",
    "predev": "npm run build:api-client",
    "prebuild": "npm run build:api-client",
    "build": "next build",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "pretypecheck": "npm run build:api-client",
    "typecheck": "next typegen && tsc --noEmit",
    "check:styles": "node scripts/check-styles.mjs",
    "lint": "eslint . && node scripts/check-styles.mjs && node scripts/check-motion.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.181",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "@iconify/react": "^6.0.4",
    "@pudans-dev/api-client": "*",
    "@react-sigma/core": "^6.0.0",
    "@shadcn/helpers": "^0.3.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-table": "^9.3.1",
    "ai": "^7.0.177",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "d3": "^7.9.2",
    "date-fns": "^4.4.0",
    "docx-preview": "^0.4.1",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "gsap": "^3.15.1",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.33",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-highlight-words": "^1.0.0",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "sigma": "^4.0.6",
    "sonner": "^2.0.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-highlight-words": "^0.20.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "graphology-types": "^0.24.8",
    "knip": "^6.45.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
