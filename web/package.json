{
  "name": "@pudans/web",
  "version": "0.1.0",
  "private": true,
  "description": "pudans React 18 rich-media frontend monorepo",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:packages": "pnpm -r build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf build app/*/dist",
    "prepare": "cd .. && husky web/.husky",
    "test": "node --test tests/",
    "test:packages": "pnpm --filter @pudans/shared build && pnpm --filter @pudans/components build",
    "check:cycles": "node scripts/check-cycles.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "audit:tokens": "node scripts/audit-design-tokens.mjs",
    "verify": "pnpm typecheck && pnpm check:cycles && pnpm check:exports && pnpm test:packages && pnpm test && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/roboto": "^5.3.0",
    "@iconify/react": "^6.0.4",
    "@marsidev/react-turnstile": "^1.6.3",
    "@mdxeditor/editor": "^3.55.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/lab": "^9.0.0-beta.10",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.18.0",
    "@mui/x-tree-view": "^9.18.0",
    "@pudans/api-client": "workspace:*",
    "@pudans/components": "workspace:*",
    "@pudans/shared": "workspace:*",
    "@reduxjs/toolkit": "^2.14.0",
    "@types/path-browserify": "^1.0.3",
    "@types/streamsaver": "^2.0.5",
    "@uiw/color-convert": "^2.10.4",
    "@uiw/react-color-sketch": "^2.10.4",
    "artplayer": "^5.4.0",
    "artplayer-plugin-chapter": "^1.1.0",
    "artplayer-plugin-hls-control": "^1.1.0",
    "axios": "^1.21.1",
    "dayjs": "^1.11.23",
    "fuse.js": "^7.5.0",
    "heic-to": "^1.6.7",
    "hls.js": "^1.7.4",
    "i18next": "^27.1.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "i18next-chained-backend": "^5.0.8",
    "i18next-http-backend": "^4.0.10",
    "i18next-localstorage-backend": "^4.3.3",
    "leaflet": "^1.9.4",
    "livephotoskit": "^1.5.6",
    "lodash": "^4.17.21",
    "mapbox-gl": "^3.35.0",
    "material-ui-popup-state": "^5.3.7",
    "monaco-editor": "^0.57.0",
    "mpegts.js": "^1.8.2",
    "mui-one-time-password-input": "^7.0.0",
    "notistack": "^3.0.2",
    "nuqs": "^2.10.3",
    "path-browserify": "^1.0.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode.react": "^4.2.0",
    "react": "18.3.1",
    "react-animate-height": "^3.2.4",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "18.3.1",
    "react-draggable": "^4.7.2",
    "react-filerobot-image-editor": "^4.9.1",
    "react-google-recaptcha": "^3.1.0",
    "react-highlight-words": "^1.0.0",
    "react-hotkeys-hook": "^5.4.0",
    "react-i18next": "^18.0.1",
    "react-image-crop": "^11.1.2",
    "react-intersection-observer": "^9.16.0",
    "react-konva": "^18.2.16",
    "react-leaflet": "^4.2.1",
    "react-reader": "^2.0.15",
    "react-redux": "^9.3.1",
    "react-router-dom": "^6.30.6",
    "react-transition-group": "^4.4.5",
    "react-virtuoso": "^4.18.23",
    "recharts": "^3.10.1",
    "redux": "^5.0.1",
    "streamsaver": "^2.0.6",
    "styled-components": "^6.6.0",
    "timeago-react": "^3.0.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/webappsec-credential-management": "^0.6.9",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "less": "^4.9.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.6",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-static-copy": "^2.3.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,less,json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
