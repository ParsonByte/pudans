{
  "name": "@pudans/web",
  "version": "0.1.0",
  "private": true,
  "description": "Pudans multi-page React frontend: auth, console and user centre.",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:packages": "pnpm -r build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:packages": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf ../build/dist",
    "test": "node --test ../tests/web/",
    "check:cycles": "node ../scripts/web/check-cycles.mjs",
    "check:exports": "node ../scripts/web/check-exports.mjs",
    "check:boundary": "node ../scripts/web/check-component-boundary.mjs",
    "audit:tokens": "node ../scripts/web/audit-design-tokens.mjs --strict",
    "check:structure": "node ../scripts/web/check-auth-structure.mjs",
    "verify": "pnpm typecheck && pnpm typecheck:packages && pnpm check:structure && pnpm check:cycles && pnpm check:exports && pnpm check:boundary && pnpm audit:tokens && pnpm test && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@iconify/react": "^6.0.4",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@pudans/api-client": "workspace:*",
    "@pudans/components": "workspace:*",
    "@pudans/shared": "workspace:*",
    "@reduxjs/toolkit": "^2.14.0",
    "i18next": "^27.1.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^18.0.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^6.30.6",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.6",
    "vite-plugin-mkcert": "^2.1.0"
  }
}
