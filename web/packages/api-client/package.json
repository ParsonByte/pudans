{
  "name": "@pudans/api-client",
  "version": "0.1.0",
  "description": "Pudans API client generated from the OpenAPI documents, aligned with Halo's api-client layout.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/entry/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entry/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declarationMap",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "axios": "^1.21.1"
  },
  "devDependencies": {
    "axios": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
