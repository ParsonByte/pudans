{
  "name": "@pudans/components",
  "version": "0.1.0",
  "description": "Pudans pure React component library (no theme, icons data, hooks, layouts or app dependencies).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.less"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declarationMap",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pudans/shared": "workspace:*",
    "@iconify/react": "catalog:",
    "@mui/x-date-pickers": "catalog:",
    "@mui/x-tree-view": "catalog:",
    "dayjs": "catalog:",
    "material-ui-popup-state": "catalog:",
    "mui-one-time-password-input": "catalog:",
    "notistack": "catalog:",
    "react-animate-height": "catalog:",
    "react-dnd": "catalog:",
    "react-dnd-html5-backend": "catalog:",
    "react-highlight-words": "catalog:",
    "react-hotkeys-hook": "catalog:",
    "react-image-crop": "catalog:",
    "react-transition-group": "catalog:",
    "recharts": "catalog:"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@mui/material": "catalog:",
    "@pudans/shared": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react-swc": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
