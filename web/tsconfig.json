{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@web/*": ["./src/*"],
      "@pudans/components": ["./packages/components/src/index.ts"],
      "@pudans/api-client": ["./packages/api-client/src/index.ts"],
      "@pudans/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "app/*/src/**/*.ts",
    "app/*/src/**/*.tsx",
    "vite.config.ts",
    "packages/*/vite.config.ts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
